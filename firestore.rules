rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /candidates/{candidateId} {
      allow read, delete: if signedIn();
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.votes == 0;
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes == resource.data.votes + 1)
      );
    }

    match /voters/{voterId} {
      allow read: if signedIn() && request.auth.uid == voterId;
      allow create: if signedIn()
        && request.auth.uid == voterId
        && request.resource.data.candidateId is string;
      allow update, delete: if false;
    }
  }
}
